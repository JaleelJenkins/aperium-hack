# Copy to .env.local and fill in.

# Google Cloud console → APIs & Services → Credentials → OAuth client (Web application).
# Add the redirect URI below to "Authorized redirect URIs" and enable the Gmail API.
# Add the test inbox as a test user on the OAuth consent screen (app stays in "Testing").
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback

# Where the SQLite DB and downloaded attachments are written.
DATA_DIR=./data

# Ingest worker
POLL_INTERVAL_MS=10000        # how often the worker asks Gmail for new history
BOOTSTRAP_DAYS=7              # first sync pulls inbox mail from the last N days
BOOTSTRAP_MAX_MESSAGES=100
MAX_ATTACHMENT_BYTES=20000000 # larger attachments are recorded but not downloaded

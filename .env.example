# Copy to .env.local and fill in. Never commit .env.local.

# --- Gmail OAuth (F1) -------------------------------------------------------
# Google Cloud console → enable Gmail API → OAuth consent screen (External, Testing)
# → add every demo inbox as a Test user → Credentials → OAuth client (Web application)
# with the redirect URI below. Testing-mode refresh tokens expire after ~7 days:
# reconnect on demo morning.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback

# Encrypts refresh/access tokens at rest. Generate with: openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=

# --- Models (F2, F7) --------------------------------------------------------
# Used by Extract, Reason and Review. Model profiles live in seed/seed.json.
ANTHROPIC_API_KEY=

# --- Live demo (run of show 1:45) -------------------------------------------
# Address of the teammate who emails the inbox from their phone during the demo.
# `npm run seed` adds it as a Harbor & Pine contact (replaces CHANGE_ME.live-demo).
LIVE_DEMO_SENDER=

# --- Storage ----------------------------------------------------------------
# SQLite DB and downloaded attachments are written here.
DATA_DIR=./data

# --- Ingest worker ----------------------------------------------------------
POLL_INTERVAL_MS=10000        # PRD: poll users.history.list every 10 seconds
BOOTSTRAP_DAYS=7              # first sync pulls inbox mail from the last N days
BOOTSTRAP_MAX_MESSAGES=100
MAX_ATTACHMENT_BYTES=20000000 # larger attachments are recorded but not downloaded
